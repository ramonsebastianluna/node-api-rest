// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------
// Core System Tables (Tablas de configuración general)
// ---------------------------------------------------------------------

model AppSetting {
  id          Int      @id @default(autoincrement())                 // ID interno
  key         String   @unique                                       // Ej: "maintenance_mode", "api_version"
  value       String                                                 // Ej: "true", "v1.0.0"
  description String?                                                // Qué hace esta configuración
  updatedAt   DateTime @updatedAt                                    // Última vez que se modificó
  
  @@map("sys_app_settings") // Nombramos la tabla en la BD con un prefijo "sys_" para indicar que es del sistema
}

// ---------------------------------------------------------------------
// Task Management Tables (Tablas de gestión de tareas)
// ---------------------------------------------------------------------

model Task {
  id          Int      @id @default(autoincrement())                 // ID interno de la tarea
  title       String                                                 // Título de la tarea
  description String?                                                // Descripción detallada
  status      TaskStatus @default(PENDING)                           // Estado actual (PENDING, IN_PROGRESS, COMPLETED)
  priority    TaskPriority @default(MEDIUM)                          // Prioridad (LOW, MEDIUM, HIGH)
  dueDate     DateTime?                                              // Fecha límite para completar la tarea
  createdAt   DateTime @default(now())                               // Fecha de creación
  updatedAt   DateTime @updatedAt                                    // Fecha de última modificación
  
  @@map("tasks") // Nombramos la tabla en la BD como "tasks"
}

// *** Enums (Tipos de datos enumerados) ***

enum TaskStatus {
  PENDING       // Pendiente
  IN_PROGRESS   // En progreso
  COMPLETED     // Completada
}

enum TaskPriority {
  LOW       // Baja
  MEDIUM    // Media
  HIGH      // Alta
}
